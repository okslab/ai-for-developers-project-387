import "@typespec/http";

using TypeSpec.Http;

namespace AppointmentBooking;

@doc("A bookable event type configured by the calendar owner.")
model EventType {
  @doc("Unique event type identifier (UUID).")
  id: string;

  @doc("Display name of the event type.")
  name: string;

  @doc("Human-readable description shown to guests.")
  description: string;

  @doc("Duration of a meeting of this type, in minutes.")
  durationMinutes: int32;
}

@doc("Payload for creating a new event type. The id is generated by the server.")
model EventTypeCreate {
  @doc("Display name of the event type.")
  name: string;

  @doc("Human-readable description shown to guests.")
  description: string;

  @doc("Duration of a meeting of this type, in minutes (positive value).")
  durationMinutes: int32;
}

@doc("A free time slot available for booking, anchored to one event type.")
model Slot {
  @doc("Identifier of the event type this slot belongs to.")
  eventTypeId: string;

  @doc("Start of the slot (ISO 8601, UTC).")
  startsAt: utcDateTime;

  @doc("End of the slot: startsAt + eventType.durationMinutes.")
  endsAt: utcDateTime;
}

@doc("A confirmed booking made by a guest.")
model Booking {
  @doc("Unique booking identifier (UUID).")
  id: string;

  @doc("Identifier of the event type being booked.")
  eventTypeId: string;

  @doc("Start of the booking (ISO 8601, UTC).")
  startsAt: utcDateTime;

  @doc("End of the booking: startsAt + eventType.durationMinutes (derived by the server).")
  endsAt: utcDateTime;

  @doc("Guest provided name.")
  guestName: string;

  @doc("Guest provided email address.")
  guestEmail: string;

  @doc("Moment the booking was created (ISO 8601, UTC).")
  createdAt: utcDateTime;
}

@doc(
  "Payload for creating a booking. The server derives endsAt from the event type duration."
)
model BookingCreate {
  @doc("Identifier of the event type to book.")
  eventTypeId: string;

  @doc("Desired slot start time (ISO 8601, UTC). Must fall inside the 14-day booking window.")
  startsAt: utcDateTime;

  @doc("Guest provided name.")
  guestName: string;

  @doc("Guest provided email address.")
  guestEmail: string;
}

@doc("A booking enriched with its event type details for the owner's upcoming-meetings view.")
model BookingWithEventType {
  ...Booking;

  @doc("Name of the booked event type.")
  eventTypeName: string;

  @doc("Description of the booked event type.")
  eventTypeDescription: string;
}

@doc("Returned when the requested time already overlaps an existing booking of any event type.")
@error
model ConflictError {
  @doc("Machine-readable error code.")
  code: "CONFLICT";

  @doc("Human-readable error message.")
  message: string;
}

@doc("Returned when the referenced resource (e.g. an event type) does not exist.")
@error
model NotFoundError {
  @doc("Machine-readable error code.")
  code: "NOT_FOUND";

  @doc("Human-readable error message.")
  message: string;
}
